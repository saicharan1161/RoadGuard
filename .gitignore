# Track the project source and selected documentation from this development workspace.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/docs/
!/work/
!/outputs/
/work/*
!/work/RoadGuardAI/
!/work/RoadGuardWindows/
/outputs/*
!/outputs/RoadGuard-0.7.0-Guide.md
!/outputs/RoadGuard-0.7.0-Validation.md
!/outputs/RoadGuard-0.7.1-Guide.md

